# ─── Golden Stay server settings ───────────────────────────────────────────
# Copy to .env (never commit .env). Everything here stays on the server:
# none of these values are bundled into the website or sent to browsers.

NODE_ENV=production
PORT=8787
# Public https origin of the site (used for PhonePe's return URL)
SITE_URL=https://your-domain.example
# Set true when running behind a reverse proxy / load balancer (nginx, Render, Railway)
TRUST_PROXY=true
DATABASE_PATH=data/golden-stay.db
# How long an unpaid booking holds the room
BOOKING_HOLD_MINUTES=30

# Owner admin login (/admin): Firebase accounts allowed in, comma-separated. The email must be verified.
ADMIN_EMAILS=goldenstay2026@gmail.com
# Optional backup password login — generate with:  npm run admin:hash
ADMIN_PASSWORD_HASH=

# Merchant QR (Method B). Values come from the owner's PhonePe merchant QR.
MERCHANT_UPI_ID=Q089453569@ybl
MERCHANT_PAYEE_LABEL=P.S

# ─── PhonePe Payment Gateway (Method A) ────────────────────────────────────
# Leave PHONEPE_ENABLED=false until PhonePe issues PG credentials.
# Dashboard: PhonePe Business → Developer Settings → API keys / Webhooks.
PHONEPE_ENABLED=false
# sandbox (UAT) or production
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Webhook URL to configure in the dashboard:  https://your-domain.example/api/webhooks/phonepe
# Set the same username/password here as in the dashboard webhook settings.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# ─── Enquiry notifications (see NOTIFICATIONS_SETUP.md) ────────────────────
# Server-only secrets. Never prefix these with VITE_ — they must not reach the browser.
# Telegram bot token from @BotFather, e.g. 123456789:AAH...
TELEGRAM_BOT_TOKEN=
# The owner's chat id (a number) from getUpdates
TELEGRAM_CHAT_ID=
# Google Apps Script web app URL (ends in /exec)
SHEETS_WEBHOOK_URL=
# Long random text; the SAME value goes in the Apps Script's Script properties as SHEETS_SECRET
SHEETS_SECRET=

# ─── Firebase (see FIREBASE_SETUP.md) ──────────────────────────────────────
# Web app config from Firebase console → Project settings → Your apps.
# These VITE_ values are PUBLIC by design (they identify the project; security
# comes from Firebase Auth + Firestore rules). They are baked into the site at build time.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Local development against the Firebase Emulator Suite (npm run emulators)
VITE_FIREBASE_EMULATORS=false

# Server side: verifies guests' sign-in tokens. SECRET file path — never commit the JSON.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=

# Signs the owner's "Review & confirm booking" email links (32+ random characters, SECRET)
OWNER_LINK_SECRET=
